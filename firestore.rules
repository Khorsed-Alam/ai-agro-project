rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AGROAI FIRESTORE SECURITY RULES
    // Role-based access for Farm Owner and Farmer workflows
    // ==========================================

    // Users: each user can read/write their own profile; owners can read farmers
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Farms: owner can read/write their own farms
    match /farms/{farmId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null &&
        (resource == null ||
         resource.data.ownerId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
      // Allow creating new farm if ownerId matches auth uid
      allow create: if request.auth != null &&
        (request.resource.data.ownerId == request.auth.uid ||
         request.resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null;
    }

    // Fields: owner can read/write; assigned farmer can read
    match /fields/{fieldId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.userId == request.auth.uid ||
         resource.data.assignedFarmerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow write: if request.auth != null &&
        (resource == null ||
         resource.data.ownerId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        (request.resource.data.ownerId == request.auth.uid ||
         request.resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null;
    }

    // Assignment Requests: owner can create; farmer can read/update their own; owner can read their own
    match /assignment_requests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
    }

    // Assignments (history records): owner and assigned farmer can read; system writes
    match /assignments/{assignmentId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow write: if request.auth != null &&
        (resource == null ||
         resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // Field Assignments (legacy audit): open for now
    match /field_assignments/{assignmentId} {
      allow read, write: if request.auth != null;
    }

    // Field Data submissions: owner and assigned farmer can access
    match /field_data/{dataId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow write: if request.auth != null &&
        (resource == null ||
         resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // Field Images: owner and farmer can access
    match /field_images/{imageId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow write: if request.auth != null &&
        (resource == null ||
         resource.data.ownerId == request.auth.uid ||
         resource.data.farmerId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // Conversations: only participants can access
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
    }

    // Messages: only participants of the conversation can access
    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.receiverId == request.auth.uid; // mark as read
    }

    // Notifications: each user can read/write their own
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Activity Logs: authenticated users can read/write
    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Legacy logs collection
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Catch-all: deny access to anything not explicitly covered
    // (Temporarily open for development - tighten before production)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
